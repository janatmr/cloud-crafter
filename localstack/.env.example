# Copy to `.env` in this directory if any default needs to change for your machine.
# `docker compose` auto-loads `.env` from this directory.

# Docker network Minikube created for its node (check with `docker network ls`;
# default profile name is "minikube"). Lambda function containers are attached
# here so they can reach the in-cluster Notifications service via the Ingress.
MINIKUBE_DOCKER_NETWORK=minikube

# Static IP given to the LocalStack container on that network, so services
# running inside Minikube (e.g. Tickets) have a stable S3 endpoint to call.
# Must be a free address in the network's subnet (check `docker network
# inspect <network>` — avoid the gateway and the Minikube node's own IP).
LOCALSTACK_IP=192.168.49.20
