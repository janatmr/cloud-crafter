PORT=3000

# Paths to an RS256 keypair used to sign/verify JWTs. Default to ./private.key and
# ./public.key (relative to this service) for local dev if unset. In Kubernetes these
# point at a mounted Secret (see charts/users and the JWT rotation docs).
JWT_PRIVATE_KEY_PATH=./private.key
JWT_PUBLIC_KEY_PATH=./public.key
